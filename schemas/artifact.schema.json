{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alchetron Artifact",
  "type": "object",
  "required": ["artifact_id", "session_id", "creator", "type", "created_at", "content_hash", "schema_version", "path", "provenance_refs"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "creator": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string" },
    "agent_version": { "type": "string" },
    "type": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 64 },
    "schema_version": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "provenance_refs": { "type": "array", "items": { "type": "string" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alchetron Private Hypothesis",
  "type": "object",
  "required": ["title", "thesis", "confidence", "evidence", "proposed_by"],
  "properties": {
    "title": { "type": "string", "minLength": 5 },
    "thesis": { "type": "string", "minLength": 20 },
    "confidence": { "type": "number" },
    "evidence": { "type": "array", "minItems": 1 },
    "node_refs": { "type": "array", "items": { "type": "string" } },
    "proposed_by": { "type": "string", "minLength": 1 },
    "model": { "type": "object" },
    "experiment": { "type": "object" }
  }
}

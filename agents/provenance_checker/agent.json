{
  "id": "provenance_checker",
  "name": "Provenance Checker",
  "version": "1.0.0",
  "purpose": "Challenge every candidate claim against its source.",
  "family": "verification",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "verify_provenance",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [
    "hallucination_challenger"
  ],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

{
  "id": "math_checker",
  "name": "Math Checker",
  "version": "1.0.0",
  "purpose": "Perform bounded symbolic or numerical sanity checking where possible.",
  "family": "verification",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "verify_math",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

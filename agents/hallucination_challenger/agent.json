{
  "id": "hallucination_challenger",
  "name": "Hallucination Challenger",
  "version": "1.0.0",
  "purpose": "Try to disprove or weaken unsupported extraction claims.",
  "family": "verification",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "challenge_claims",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

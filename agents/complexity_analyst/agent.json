{
  "id": "complexity_analyst",
  "name": "Complexity Analyst",
  "version": "1.0.0",
  "purpose": "Analyze time and space complexity and mark SOURCE_STATED, DERIVED, or UNKNOWN.",
  "family": "analysis",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "analyze_complexity",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

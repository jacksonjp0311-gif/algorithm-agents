{
  "id": "repository_scout",
  "name": "Repository Scout",
  "version": "1.0.0",
  "purpose": "Inspect public repositories for implementation references relevant to a directive.",
  "family": "acquisition",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "inspect_repository",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

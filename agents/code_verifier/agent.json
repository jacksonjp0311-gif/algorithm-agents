{
  "id": "code_verifier",
  "name": "Code Verifier",
  "version": "1.0.0",
  "purpose": "Execute only explicitly bounded reference implementations.",
  "family": "verification",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
  "allowed_tools": [
    "verify_code",
    "submit_artifact"
  ],
  "denied_tools": [
    "publish_algorithm",
    "modify_canonical_archive",
    "unrestricted_shell"
  ],
  "can_message": [],
  "timeout_seconds": 120,
  "max_retries": 2,
  "enabled": true
}

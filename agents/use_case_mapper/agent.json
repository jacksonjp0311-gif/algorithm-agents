{
  "id": "use_case_mapper",
  "name": "Use-Case Mapper",
  "version": "1.0.0",
  "purpose": "Separate known uses from potential uses.",
  "family": "knowledge",
  "inputs": [
    "source_document"
  ],
  "outputs": [
    "artifact"
  ],
